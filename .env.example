# Disclosure Checklist Agent — copy to .env and fill in.
# Placeholder values only. Never commit a real key.

# ---------------------------------------------------------------------------
# REQUIRED — the app refuses to start without these
# ---------------------------------------------------------------------------

# Gemini model id. Never hardcoded anywhere in the codebase.
GEMINI_MODEL=gemini-flash-latest

# The origin allowed to POST /api/confirm. Must match the URL you actually
# browse to, or every confirmation is rejected with 403.
APP_URL=http://localhost:8080

# Append-only JSONL audit log.
AUDIT_LOG_PATH=./audit.jsonl

# ---------------------------------------------------------------------------
# FEATURE — unset is a supported mode, not an error
# ---------------------------------------------------------------------------

# Leave blank to run in OFFLINE mode: no model is called, reason text comes
# from each rule's own summary field, and the result is labelled mode=offline
# in both the audit log and the UI. Bucket membership, citations, tiers, the
# audit log and the confirm flow are identical either way.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults in app/config.py
# ---------------------------------------------------------------------------

RATE_LIMIT_PER_MINUTE=10
MAX_MODEL_CALLS_PER_DAY=200
